{
  "name": "specr-verify-harness",
  "private": true,
  "version": "0.1.0",
  "description": "Visual round-trip verification harness (#150): docx-preview + pixel diff, agent-driven. Isolated pnpm package — see pnpm-workspace.yaml.",
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "lint": "eslint src/ && tsc --noEmit && prettier --check src/",
    "format": "prettier --write src/",
    "test": "vitest run"
  },
  "dependencies": {
    "docx": "^9.6.1",
    "docx-preview": "^0.4.0",
    "express": "^5.2.1",
    "jszip": "^3.10.0",
    "multer": "^2.1.1",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.13.3",
    "@types/pngjs": "^6.0.5",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-sonarjs": "^4.2.0",
    "prettier": "^3.9.6",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.5"
  }
}
