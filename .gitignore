# RESTRICTED: Copyrighted specification files that cannot be redistributed
# ARCAT guide specifications - copyright ARCAT, Inc.
docs/references/ARCAT/*.docx

# Manufacturer specifications (CPI, etc.) - copyright respective manufacturers
docs/references/MANUFACTURER_CPI/*.docx
docs/references/MANUFACTURER_*/*.docx

# Text-extracted copies of copyrighted specs (parser test fixtures only - never commit)
tests/fixtures/text/cpi-*.txt
tests/fixtures/text/arcat-*.txt
tests/fixtures/text/manufacturer-*.txt

# UFGS source fixtures — extracted at implementation time, values encoded in migrations
docs/references/UFGS/**/*.docx

# Test output
coverage/

# Temporary/working files
tmp/
*.tmp
.worktrees
.superpowers/

# Windows one-click bootstrap runtime (portable Node + PostgreSQL + data)
.specr-runtime/

# Playwright MCP verification artifacts
.playwright-mcp/

# Vendored CDN assets (produced by pnpm vendor:scalar; never committed).
# Narrowed to the vendored dir so the committed mockup SPA (public/js, public/css,
# public/index.html) stays tracked.
public/scalar/
