# Dependencies
node_modules/
.pnp.*
.yarn/

# Build
dist/
build/
*.tsbuildinfo

# Environment
.env
.env.*
!.env.example
*.mcp.json

# IDE
.vscode/
.idea/
*.swp
*.swo
.claude/
.playwright-mcp/

# OS
.DS_Store
Thumbs.db

# RESTRICTED: Copyrighted specification files that cannot be redistributed
# ARCAT guide specifications - copyright ARCAT, Inc.
docs/references/ARCAT/*.docx

# Manufacturer specifications (CPI, etc.) - copyright respective manufacturers
docs/references/MANUFACTURER_CPI/*.docx
docs/references/MANUFACTURER_*/*.docx
# Rendered/derived artifacts of those specs (screenshots, editor lock files) — also never commit
docs/references/MANUFACTURER_*/*.png
docs/references/MANUFACTURER_*/.~lock.*#

# Text-extracted copies of copyrighted specs (parser test fixtures only - never commit)
tests/fixtures/text/cpi-*.txt
tests/fixtures/text/arcat-*.txt
tests/fixtures/text/manufacturer-*.txt

# UFGS source fixtures — extracted at implementation time, values encoded in migrations
docs/references/UFGS/**/*.docx

# Test output
coverage/

# Rotating JSONL log files (pino-roll; see src/lib/logger.ts)
logs/

# Temporary/working files
tmp/
*.tmp
.worktrees
.superpowers/

# Vendored CDN assets (produced by pnpm vendor:scalar; never committed).
# Anchored to the repo root (leading slash) — an unanchored `public/` also
# matched tools/verify/public/, which is committed source (#150 task 7/8),
# not a vendored/generated asset.
/public/

# Fixture A/B snapshots (copyright-derived parse renders; never committed)
.fixture-snapshots/

# tools/verify's local working directory (screenshots, rendered artifacts) —
# local dev tool, out of CI; see issue #150 design decision 5.
tools/verify/work/

# pnpm's content-addressable store. Appears at the repo root whenever pnpm runs
# with a HOME that cannot host the default store location — notably `pnpm install`
# inside a container that bind-mounts this directory. Pure cache; never committed.
.pnpm-store/

# agentkit: .agent/ is working state; these two files are the declaration
.agent/*
!.agent/config.env
!.agent/board.json
