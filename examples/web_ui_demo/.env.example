# SpecR web UI demo — local configuration
#
# Copy this file to `.env` (same folder) and fill in your values:
#     cp .env.example .env
#
# `.env` is gitignored; only this `.env.example` is committed. `server.mjs`
# auto-loads `.env` from THIS folder on startup, and the one-command launchers
# (Start-SpecR.sh / .ps1) also hand this file to the SpecR API process as its
# --env-file — a real shell/CI environment variable always takes precedence over
# a value set here.

# --- LLM-backed features (Ask SpecR chat + Compose reporting) — optional ----
# The demo speaks to ONE provider, chosen explicitly here (keys alone never
# switch it): "openai" or "anthropic". Organizations holding a usage-based
# enterprise API key under a data-protection agreement with either provider
# can point the demo at whichever one their agreement covers. The selected
# provider's key is read ONLY by this server and never sent to the browser.
# Leave the key blank to run with chat + Compose disabled (each shows a clear
# "not configured" note).
LLM_PROVIDER=openai

# --- OpenAI (LLM_PROVIDER=openai) --------------------------------------------
# A RESTRICTED key needs the Responses write permission: the demo calls the
# Responses API (for native tool search), not Chat Completions, so a key scoped
# only to Chat Completions authenticates and then fails on the first message
# with "Missing scopes: api.responses.write".
OPENAI_API_KEY=

# Chat model — the demo exposes SpecR's full MCP catalog through native tool
# search, which requires the Responses API and gpt-5.4 or newer. Defaults to
# gpt-5.6-luna (the cheapest tier clearing that floor) when unset.
OPENAI_MODEL=gpt-5.6-luna

# OpenAI-compatible base URL — override to point at Azure OpenAI, OpenRouter, a
# local proxy, etc. Defaults to the public OpenAI API when unset.
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Anthropic (LLM_PROVIDER=anthropic) ---------------------------------------
ANTHROPIC_API_KEY=

# Chat model — native tool search requires Sonnet 4.5 / Opus 4.5 or newer.
# Defaults to claude-sonnet-4-6 when unset.
ANTHROPIC_MODEL=claude-sonnet-4-6

# Anthropic base URL — override for an enterprise gateway or proxy. Defaults to
# the public Anthropic API when unset. No /v1 suffix (the server appends
# /v1/messages).
ANTHROPIC_BASE_URL=https://api.anthropic.com

# --- Servers ----------------------------------------------------------------
# Port this demo server listens on. Defaults to 3001.
# (The one-command launchers pass PORT inline and will override this.)
PORT=3001

# Bind address. Defaults to 127.0.0.1 (private to this machine). Set HOST=0.0.0.0
# to reach the demo from other machines on your LAN — this also exposes the
# proxied SpecR API and the LLM-backed chat, so only do it on a trusted network.
HOST=127.0.0.1

# Base URL of the running SpecR REST API this demo proxies to. Defaults to
# http://127.0.0.1:3000.
SPECR_API_BASE=http://127.0.0.1:3000

# --- SpecR API rate limiting ------------------------------------------------
# The one-command launchers start the SpecR API with THIS file as its --env-file,
# so this setting reaches the API process (not just this demo server). The demo
# ships with rate limiting OFF so you can load many sections and chat freely
# without tripping the API's per-IP upload and /mcp quotas. Set to false to
# exercise the production-default limits locally.
DISABLE_RATE_LIMIT=true
