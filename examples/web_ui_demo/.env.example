# SpecR web UI demo — local configuration
#
# Copy this file to `.env` (same folder) and fill in your values:
#     cp .env.example .env
#
# `.env` is gitignored; only this `.env.example` is committed. `server.mjs`
# auto-loads `.env` from THIS folder on startup — a real shell/CI environment
# variable always takes precedence over a value set here.

# --- Ask SpecR chat sidebar (optional) --------------------------------------
# Leave OPENAI_API_KEY blank to run the demo with the "Ask SpecR" chat disabled
# (the sidebar shows a clear "not configured" note). The key is read ONLY by
# this server and is never sent to the browser — the browser talks to the demo's
# /chat endpoint, which calls OpenAI server-side.
OPENAI_API_KEY=

# Chat model — any OpenAI chat-completions / tool-calling model, e.g.
# gpt-4o-mini, gpt-4o, gpt-5.4. Defaults to gpt-4o-mini when unset.
OPENAI_MODEL=gpt-4o-mini

# OpenAI-compatible base URL — override to point at Azure OpenAI, OpenRouter, a
# local proxy, etc. Defaults to the public OpenAI API when unset.
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Servers ----------------------------------------------------------------
# Port this demo server listens on. Defaults to 3001.
# (The one-command launchers pass PORT inline and will override this.)
PORT=3001

# Bind address. Defaults to 127.0.0.1 (private to this machine). Set HOST=0.0.0.0
# to reach the demo from other machines on your LAN — this also exposes the
# proxied SpecR API and the OpenAI-backed chat, so only do it on a trusted network.
HOST=127.0.0.1

# Base URL of the running SpecR REST API this demo proxies to. Defaults to
# http://127.0.0.1:3000.
SPECR_API_BASE=http://127.0.0.1:3000
