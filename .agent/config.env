# .agent/config.env -- repository facts for agent skills.
# Generated by bootstrap-repo.sh. Parsed line-wise, never sourced.
# Regenerate with: bootstrap-repo.sh --force

AGENT_REPO_SLUG=wrzonance/SpecR
AGENT_BASE_BRANCH=main
AGENT_PROJECT_OWNER=wrzonance
AGENT_PROJECT_NUMBER=4
AGENT_STATUS_VOCAB=Backlog,Ready,In progress,In review,Done
AGENT_ADR_DIR=docs/adr
AGENT_WORKTREE_ROOT=.worktrees

# This repository's labels, for you to split by intent. Uncomment and
# classify the ones agents should reuse instead of inventing new labels.
#   bug,documentation,duplicate,enhancement,good first issue,help wanted,invalid,question,wontfix,major-update,ci,security,phase:1c,phase:2b,phase:2c,phase:3,phase:4,phase:5,phase:6,phase:2d,phase:2e,phase:onboarding,style-fidelity:2,style-fidelity:5,style-fidelity:6,style-fidelity:7,style-fidelity:1,style-fidelity:3,style-fidelity:4,dependencies,phase:7,release:1.0,javascript,github_actions
AGENT_LABEL_TYPES=bug,documentation,duplicate,enhancement,good first issue,help wanted,invalid,question,wontfix,major-update
AGENT_LABEL_AREAS=ci,security,phase:1c,phase:2b,phase:2c,phase:3,phase:4,phase:5,phase:6,phase:2d,phase:2e,phase:onboarding,phase:7,style-fidelity:2,style-fidelity:5,style-fidelity:6,style-fidelity:7,style-fidelity:1,style-fidelity:3,style-fidelity:4,dependencies,javascript,github_actions
AGENT_LABEL_PRIORITIES=release:1.0

# Candidate verify commands found in this repository. Uncomment the ones
# agents should run, as AGENT_CMD_<NAME>=<command>. Commands are argv:
# no shell, no pipes, no redirects. For anything more, use .agent/runner.
#   tools/verify
#   npm run test
#   npm run lint
#   npm run build
AGENT_CMD_VERIFY=pnpm lint
AGENT_CMD_TEST=pnpm test
AGENT_CMD_BUILD=pnpm build
