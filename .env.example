PORT=3000
DATABASE_URL=postgres://specr:specr@localhost:5432/specr
NODE_ENV=development
LOG_LEVEL=info

# PDF OCR fallback (scanned/image-only PDFs). All optional — sane defaults apply.
OCR_MIN_CHARS_PER_PAGE=16
OCR_LOW_CONFIDENCE_THRESHOLD=70
OCR_RENDER_SCALE=2
# OCR_LANG_PATH / OCR_CACHE_PATH: point Tesseract at LOCAL traineddata. In an
# offline/network-restricted deployment, set OCR_LANG_PATH to a directory holding
# eng.traineddata — otherwise tesseract.js fetches it from a CDN on first use,
# which is unavailable offline. See issue tracking offline OCR provisioning.
# OCR_LANG_PATH=/opt/specr/tessdata
# OCR_CACHE_PATH=/var/cache/specr-tesseract
