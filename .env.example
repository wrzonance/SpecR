PORT=3000
DATABASE_URL=postgres://specr:specr@localhost:5432/specr
NODE_ENV=development
LOG_LEVEL=info

# PDF OCR fallback (scanned/image-only PDFs). All optional — sane defaults apply.
OCR_MIN_CHARS_PER_PAGE=16
OCR_LOW_CONFIDENCE_THRESHOLD=70
OCR_RENDER_SCALE=2
# Max time (ms) to wait for the Tesseract worker to initialize before degrading
# to a `pdf-ocr-unusable` warning. Guards against an indefinite stall when an
# uncached eng.traineddata CDN fetch connects but never responds (ADR-039).
OCR_INIT_TIMEOUT_MS=30000
# OCR_LANG_PATH / OCR_CACHE_PATH: point Tesseract at LOCAL traineddata. PRODUCTION
# OCR MUST NOT depend on a CDN — vendor eng.traineddata (Apache-2.0) and set
# OCR_LANG_PATH to its directory (ADR-039). In an offline/network-restricted
# deployment, an unset OCR_LANG_PATH with an empty cache makes tesseract.js fetch
# eng.traineddata from a CDN on first use, which is unavailable offline.
# OCR_LANG_PATH=/opt/specr/tessdata
# OCR_CACHE_PATH=/var/cache/specr-tesseract
