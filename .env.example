PORT=3000
DATABASE_URL=postgres://specr:specr@localhost:5432/specr
NODE_ENV=development
LOG_LEVEL=info

# PDF OCR fallback (scanned/image-only PDFs). All optional — sane defaults apply.
OCR_MIN_CHARS_PER_PAGE=16
OCR_LOW_CONFIDENCE_THRESHOLD=70
OCR_RENDER_SCALE=2
# Max time (ms) to wait for the Tesseract worker to initialize before degrading
# to a `pdf-ocr-unusable` warning. Guards against an indefinite stall when an
# uncached eng.traineddata CDN fetch connects but never responds (ADR-039).
OCR_INIT_TIMEOUT_MS=30000
# Strict offline OCR. Set true in offline/locked-down deployments: OCR is refused
# (degrades to `pdf-ocr-unusable`) unless eng.traineddata is present locally, and
# the check runs BEFORE any worker spawns — so a black-hole CDN fetch can never
# spawn (and leak) a worker. Default false keeps the dev-friendly CDN-on-first-run
# behavior. PRODUCTION: set this true AND provision local traineddata (ADR-039).
OCR_REQUIRE_LOCAL_TRAINEDDATA=false
# OCR_LANG_PATH / OCR_CACHE_PATH: point Tesseract at LOCAL traineddata. PRODUCTION
# OCR MUST NOT depend on a CDN — vendor eng.traineddata (Apache-2.0) and set
# OCR_LANG_PATH to its directory (ADR-039). In an offline/network-restricted
# deployment, an unset OCR_LANG_PATH with an empty cache makes tesseract.js fetch
# eng.traineddata from a CDN on first use, which is unavailable offline.
# OCR_LANG_PATH=/opt/specr/tessdata
# OCR_CACHE_PATH=/var/cache/specr-tesseract
# Which MCP capability tiers are exposed as callable tools (comma-separated:
# read, write, destructive). Default omits `destructive` so an agent cannot
# delete projects/clients/libraries (ADR-045).
MCP_ALLOWED_TIERS=read,write

# Rate limiting (express-rate-limit). Seeded at boot and read LIVE per request, so a
# future admin surface can change these at runtime (no restart). Secure default: ON.
# The web UI demo disables limiting via its own .env (examples/web_ui_demo/.env).
# DISABLE_RATE_LIMIT=true turns OFF all limiting (dev/demo only).
DISABLE_RATE_LIMIT=false
# Max file-upload requests per IP per window (POST /parse, /templates/import,
# /libraries/:id/import, /numbering-profiles/snapshot).
RATE_LIMIT_UPLOAD_MAX=10
# Max POST /mcp requests per IP per window.
RATE_LIMIT_MCP_MAX=20
# Rolling window in milliseconds (fixed when a limiter is constructed).
RATE_LIMIT_WINDOW_MS=60000
